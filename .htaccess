<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block access to hidden files and directories (dotfiles) except .well-known
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]

    # Block access to sensitive files (environment, dependencies, logs, backups, and artisan)
    RewriteRule "(^|/)(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.env.*|\.(bak|sql|sqlite|ini|log|sh))$" - [F,L,NC]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Route build assets to public folder (always)
    RewriteRule ^build/(.*)$ public/build/$1 [L]

    # Route media and images assets to public folder (always)
    RewriteRule ^media/(.*)$ public/media/$1 [L]
    RewriteRule ^images/(.*)$ public/images/$1 [L]

    # Route storage assets to public folder (always)
    RewriteCond %{REQUEST_URI} /storage/(.*)$
    RewriteRule ^.*$ public/storage/%1 [L]

    # Serve static files from public directory if they exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Direct FilesMatch fallback denial for both Apache 2.2 and 2.4
<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(^\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|\.(bak|sql|sqlite|ini|log|sh))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Defense-in-depth security headers for static assets
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(self), fullscreen=(self)"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>
