APP_NAME=Mycard
APP_ENV=local
APP_KEY=base64:/CQ1xdIYqMTT9NmrM6uTOyOnb81E9MbnLxUG29c4seQ=
APP_DEBUG=true
APP_URL=http://localhost/mycard

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mycard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BEEM_API_KEY=your_beem_api_key_here
BEEM_SECRET_KEY=your_beem_secret_key_here
BEEM_WHATSAPP_FROM=2557xxxxxxx
BEEM_BROADCAST_BASE=https://apibroadcast.beem.africa
BEEM_CHAT_BASE=https://apichatcore.beem.africa

VITE_APP_NAME="${APP_NAME}"

# Beem Africa Bulk SMS (put real values ONLY in .env, never here)
BEEM_SMS_API_KEY=your_beem_sms_api_key_here
BEEM_SMS_SECRET_KEY=your_beem_sms_secret_key_here
BEEM_SMS_SENDER_ID=INFO
BEEM_SMS_CALLBACK_URL=https://yourdomain.com/beem/dlr

# PRODUCTION SECURITY: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Optional: path to CA bundle if PHP has none (Windows/XAMPP). Leave empty on Linux servers.
HTTP_CA_BUNDLE=
